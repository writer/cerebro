{
  "id": "k8s-rbac-secret-read-access",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "User/ServiceAccount Can Read Kubernetes Secrets",
  "description": "A user or service account can get/list/watch Kubernetes Secrets via RBAC bindings.",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "k8s::rbac::risky_binding",
  "conditions": [
    "in_list(path(resource, \"subject_kind\"), [\"User\",\"ServiceAccount\"])",
    "contains_value(path(resource, \"risk_reasons\"), \"secret_access\")"
  ],
  "condition_format": "cel",
  "severity": "low",
  "tags": [
    "kubernetes",
    "rbac",
    "secrets",
    "least-privilege"
  ],
  "remediation": "Remove unnecessary secret read permissions and scope access to only required namespaces and identities.",
  "risk_categories": [
    "IDENTITY_RISK",
    "PRIVILEGE_ESCALATION"
  ],
