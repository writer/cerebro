{
  "id": "k8s-ingress-no-wildcard-host",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "Kubernetes Ingress Avoids Wildcard Hosts",
  "description": "Ingress resources should not use wildcard hosts that broaden routing scope.",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "k8s::networking::ingress",
  "conditions": [
    "cmp_eq(path(resource, \"wildcard_host\"), true)"
  ],
  "condition_format": "cel",
  "severity": "medium",
  "tags": [
    "kubernetes",
    "ingress",
    "network"
  ],
  "remediation": "Use explicit hostnames for ingress rules instead of wildcard hosts.",
  "risk_categories": [
    "EXTERNAL_EXPOSURE",
    "MISCONFIGURATION"
  ],
