  "last_modified": "0001-01-01T00:00:00Z",
  "name": "Kubernetes Pod Requires Liveness Probes",
  "description": "All containers should define liveness probes for reliable health monitoring.",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "kubernetes::pod",
  "conditions": [
    "cmp_ne(path(resource, \"spec.all_containers_have_liveness_probe\"), true)"
  ],
  "condition_format": "cel",
  "severity": "medium",
