{
  "id": "k8s-pod-resource-limits",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "K8s Pod Resource Limits",
  "description": "Containers should have CPU and memory limits defined",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "kubernetes::pod",
  "conditions": [
    "cmp_eq(path(resource, \"spec.containers.resources.limits.memory\"), null)",
    "cmp_eq(path(resource, \"spec.containers.resources.limits.cpu\"), null)"
  ],
  "condition_format": "cel",
  "severity": "medium",
  "tags": [
    "pod-security",
    "resources",
    "availability"
  ],
  "remediation": "Define CPU and memory limits for all containers.",
  "risk_categories": [
    "MISCONFIGURATION"
  ],
  "frameworks": [
    {
      "name": "SOC 2",
      "controls": [
        "A1.1",
        "A1.2",
        "A1.3"
      ]
    },
    {
      "name": "ISO 27001:2022",
      "controls": [
        "A.5.30",
        "A.8.14"
      ]
    },
    {
      "name": "NIST 800-53 r5",
      "controls": [
        "CP-2",
        "CP-4"
      ]
    },
    {
      "name": "Cerebro Operational Resilience",
      "controls": [
        "OPS-2"
      ]
    }
  ]
}
