{
  "id": "k8s-pod-seccomp-runtime-default",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "Kubernetes Pod Uses RuntimeDefault Seccomp",
  "description": "Pods should run with RuntimeDefault seccomp profiles for all containers.",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "kubernetes::pod",
  "conditions": [
    "cmp_ne(path(resource, \"spec.all_containers_runtime_default_seccomp\"), true)"
  ],
  "condition_format": "cel",
  "severity": "medium",
  "tags": [
    "kubernetes",
    "pod-security",
    "seccomp"
  ],
  "remediation": "Set seccompProfile.type: RuntimeDefault at pod or container level.",
  "risk_categories": [
    "MISCONFIGURATION"
  ],
