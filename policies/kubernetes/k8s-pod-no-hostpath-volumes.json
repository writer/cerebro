{
  "id": "k8s-pod-no-hostpath-volumes",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "Kubernetes Pod Avoids hostPath Volumes",
  "description": "Pods should not mount hostPath volumes because they can expose host resources.",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "kubernetes::pod",
  "conditions": [
    "cmp_eq(path(resource, \"spec.uses_host_path_volume\"), true)"
  ],
  "condition_format": "cel",
  "severity": "high",
  "tags": [
    "kubernetes",
    "pod-security",
    "storage"
  ],
  "remediation": "Replace hostPath volumes with safer volume types such as PVCs, ConfigMaps, or Secrets.",
  "risk_categories": [
    "PRIVILEGE_ESCALATION",
    "MISCONFIGURATION"
  ],
