{
  "id": "k8s-pod-image-pinned-by-digest",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "Kubernetes Pod Images Pinned by Digest",
  "description": "Pod images should be pinned by digest to reduce supply chain drift.",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "kubernetes::pod",
  "conditions": [
    "cmp_ne(path(resource, \"spec.all_images_pinned_by_digest\"), true)"
  ],
  "condition_format": "cel",
  "severity": "medium",
  "tags": [
    "kubernetes",
    "supply-chain",
    "image"
  ],
  "remediation": "Reference images using immutable digests (for example image@sha256:...).",
  "risk_categories": [
    "MISCONFIGURATION"
  ],
