{
  "id": "k8s-workload-not-default-namespace",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "Kubernetes Workloads Avoid Default Namespace",
  "description": "Application workloads should not run in the default namespace.",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "kubernetes::deployment",
  "conditions": [
    "cmp_eq(path(resource, \"namespace\"), \"default\")"
  ],
  "condition_format": "cel",
  "severity": "low",
  "tags": [
    "kubernetes",
    "namespace",
    "segmentation"
  ],
  "remediation": "Deploy workloads into dedicated namespaces with scoped RBAC and network policies.",
