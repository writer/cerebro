{
  "id": "aws-ecr-scan-on-push-disabled",
  "name": "AWS ECR Scan On Push Disabled",
  "description": "ECR repository does not have scan on push enabled",
  "effect": "forbid",
  "resource": "aws::ecr::repository",
  "conditions": [
    "image_scanning_configuration.scan_on_push != true"
  ],
  "severity": "medium",
  "remediation": "Enable scan on push for the ECR repository.",
  "tags": [
    "cicd",
    "ecr",
    "container-security",
    "vulnerability-scanning"
  ],
  "risk_categories": [
    "MISCONFIGURATION",
    "VULNERABILITY"
  ],
  "frameworks": [
    {
      "name": "NIST 800-53 r5",
      "controls": [
        "RA-5",
        "SI-2"
      ]
    },
    {
      "name": "PCI DSS v4.0.1",
      "controls": [
        "6.3",
        "11.3"
      ]
    },
    {
      "name": "CIS Controls v8",
      "controls": [
        "7"
      ]
    }
  ]
}