        "CC7.1"
      ]
    },
    {
      "name": "NIST 800-53 r5",
      "controls": [
        "RA-5",
        "SI-2"
      ]
    },
    {
      "name": "PCI DSS v4.0.1",
      "controls": [
        "6.3",
        "11.3"
      ]
    },
    {
      "name": "CIS Controls v8",
      "controls": [
        "7"
      ]
    }
  ],
  "control_id": "wc-id-454",
  "remediation": "Enable vulnerability scanning for all container registries. Review unscanned images."
