{
  "id": "gcr-unscanned",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "GCP container registry contains an unscanned image that is used by a container",
  "description": "An unscanned container image from GCR is in use",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "container::image",
  "conditions": [
    "cmp_eq(path(resource, \"registry_type\"), \"gcr\")",
    "cmp_eq(path(resource, \"scanned\"), false)"
  ],
  "condition_format": "cel",
  "severity": "medium",
  "tags": [
    "gcp",
    "container-registry",
    "scanning"
  ],
  "frameworks": [
