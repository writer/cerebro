{
  "id": "wiz-bucket-public-sensitive",
  "wiz_control_id": "wc-id-1264",
  "name": "Publicly readable bucket contains sensitive data",
  "description": "A publicly readable storage bucket contains sensitive data findings, creating a data breach risk",
  "effect": "forbid",
  "resource": "storage::bucket|storage::blob_container|storage::account",
  "conditions": [
    "is_public == true",
    "sensitive_data_findings ANY (severity IN ('CRITICAL', 'HIGH'))"
  ],
  "severity": "critical",
  "remediation": "Remove public access immediately. Implement proper access controls. Review and rotate any exposed credentials found in the bucket.",
  "tags": [
    "wiz",
    "storage",
    "sensitive-data",
    "public-exposure",
    "data-breach"
  ],
  "risk_categories": [
    "EXTERNAL_EXPOSURE",
    "UNPROTECTED_DATA"
  ],
  "frameworks": [
    {
      "name": "NIST 800-53 r5",
      "controls": [
        "AC-3",
        "SC-7"
      ]
    },
    {
      "name": "PCI DSS v4.0.1",
      "controls": [
        "1.3",
        "1.4"
      ]
    },
    {
      "name": "SOC 2",
      "controls": [
        "CC6"
      ]
    },
    {
      "name": "CIS Controls v8",
      "controls": [
        "12",
        "13"
      ]
    }
  ],
  "mitre_attack": [
    {
      "tactic": "Initial Access",
      "technique": "T1190"
    },
    {
      "tactic": "Collection",
      "technique": "T1530"
    }
  ]
}