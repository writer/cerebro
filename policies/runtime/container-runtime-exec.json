      "controls": [
        "A.5.24",
        "A.5.25",
        "A.8.16"
      ]
    },
    {
      "name": "NIST 800-53 r5",
      "controls": [
        "IR-4",
        "SI-4"
      ]
    },
    {
      "name": "CIS Controls v8",
      "controls": [
        "8"
      ]
    },
    {
      "name": "SOC 2",
      "controls": [
        "CC7.3",
        "CC7.4",
        "CC7.5"
      ]
    },
    {
      "name": "ISO 27001:2022",
      "controls": [
        "A.5.24",
