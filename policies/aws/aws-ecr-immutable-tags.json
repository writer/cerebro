{
  "id": "aws-ecr-immutable-tags",
  "last_modified": "0001-01-01T00:00:00Z",
  "name": "ECR Immutable Image Tags",
  "description": "ECR repositories should use immutable image tags to prevent overwrites",
  "effect": "forbid",
  "principal": "",
  "action": "",
  "resource": "aws::ecr::repository",
  "conditions": [
    "cmp_ne(path(resource, \"image_tag_mutability\"), \"IMMUTABLE\")"
  ],
  "condition_format": "cel",
  "severity": "medium",
  "tags": [
    "ecr",
    "container",
    "supply-chain",
    "immutability"
  ],
  "remediation": "Set image tag mutability to IMMUTABLE to prevent image tag overwrites.",
  "risk_categories": [
    "MISCONFIGURATION"
  ],
  "frameworks": [
    {
      "name": "SOC 2",
      "controls": [
        "CC7.1",
        "CC8.1"
      ]
    },
    {
      "name": "NIST 800-53 r5",
      "controls": [
        "CM-5",
        "CM-7",
        "SI-7",
        "SR-11"
      ]
    },
    {
      "name": "PCI DSS v4.0.1",
      "controls": [
        "6.3",
        "6.5"
      ]
    },
    {
      "name": "CIS Controls v8",
      "controls": [
        "2",
        "7",
        "16"
      ]
    }
  ]
}
