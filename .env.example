# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/cerebro

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token_here

# AWS Integration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# Google Cloud Integration
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your-gcp-project-id

# Google Workspace Integration
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@yourdomain.com
GOOGLE_WORKSPACE_CUSTOMER_ID=your_customer_id

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rule Engine
CEL_CACHE_SIZE=1000
CEL_COMPILATION_TIMEOUT=30

# Collectors
COLLECTOR_BATCH_SIZE=100
COLLECTOR_RATE_LIMIT=10
COLLECTOR_TIMEOUT=300

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE="Cerebro Security API"
API_DESCRIPTION="Security System of Record API"

# Redis/Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
