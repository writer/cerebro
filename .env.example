# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/cerebro

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token_here

# AWS Integration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# Google Cloud Integration
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your-gcp-project-id

# Google Workspace Integration
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@yourdomain.com
GOOGLE_WORKSPACE_CUSTOMER_ID=your_customer_id

# Okta Integration
OKTA_API_TOKEN=your_okta_api_token_here
OKTA_DOMAIN=company.okta.com

# Microsoft 365 Integration
M365_TENANT_ID=your_tenant_id_here
M365_CLIENT_ID=your_client_id_here
M365_CLIENT_SECRET=your_client_secret_here

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rule Engine
CEL_CACHE_SIZE=1000
CEL_COMPILATION_TIMEOUT=30

# Collectors
COLLECTOR_BATCH_SIZE=100
COLLECTOR_RATE_LIMIT=10
COLLECTOR_TIMEOUT=300

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE="Cerebro Security API"
API_DESCRIPTION="Security System of Record API"

# Redis/Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Key Management Service (choose one)
KMS_PROVIDER=local  # local, aws, gcp, azure, vault

# AWS KMS
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
AWS_KMS_REGION=us-east-1

# GCP KMS  
GCP_KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY

# Azure Key Vault
AZURE_VAULT_URL=https://vault.vault.azure.net/
AZURE_KEY_NAME=encryption-key

# HashiCorp Vault
VAULT_URL=https://vault.company.com
VAULT_MOUNT_PATH=transit
VAULT_KEY_NAME=cerebro-encryption
