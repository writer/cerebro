# Snowflake (primary data store)
SNOWFLAKE_CONNECTION_STRING=user:password@account/CEREBRO/RAW?warehouse=COMPUTE_WH

# AWS (for CloudQuery sync)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP (for CloudQuery sync)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure (for CloudQuery sync)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# API
API_PORT=8080
LOG_LEVEL=info
