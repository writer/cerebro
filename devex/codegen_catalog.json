{
  "api_version": "devex.cerebro/v1alpha1",
  "kind": "CodegenCatalog",
  "families": [
    {
      "id": "openapi",
      "title": "OpenAPI Route Parity",
      "summary": "Keeps registered routes, placeholder synchronization, and OpenAPI linting aligned.",
      "change_reason": "API route or OpenAPI surface changed",
      "triggers": [
        "api/openapi.yaml",
        "internal/bootstrap/routes.go",
        "scripts/openapi_route_parity.go"
      ],
      "generator": {
        "make_target": "openapi-sync",
        "command": [
          "make",
          "openapi-sync"
        ],
        "summary": "Regenerate OpenAPI route placeholders and write the contract file."
      },
      "checks": [
        {
          "key": "openapi-check",
          "summary": "Verify registered HTTP routes are represented in OpenAPI",
          "make_target": "openapi-check",
          "command": [
            "make",
            "openapi-check"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "openapi-lint",
          "summary": "Lint the OpenAPI contract",
          "make_target": "openapi-lint",
          "command": [
            "make",
            "openapi-lint"
          ]
        }
      ],
      "outputs": [
        "api/openapi.yaml"
      ],
      "ci_jobs": [
        "openapi"
      ]
    },
    {
      "id": "openapi-connector-definition",
      "title": "OpenAPI Connector Definition Codegen",
      "summary": "Generates sourcegen-ready connector definitions from provider OpenAPI specs by selecting high-value read endpoints, auth, pagination, selectors, and projection templates.",
      "change_reason": "Provider OpenAPI specs, connector definition inference, or automated platform coverage planning changed",
      "triggers": [
        "internal/connectordefinitions/openapigen/**",
        "tools/openapidefgen/**",
        "internal/connectordefinitions/**",
        "internal/sourcegen/**"
      ],
      "generator": {
        "make_target": "openapi-definition-gen-test",
        "command": [
          "make",
          "openapi-definition-gen-test"
        ],
        "summary": "Validate OpenAPI-to-connector-definition generation and sourcegen compatibility."
      },
      "checks": [
        {
          "key": "openapi-definition-gen-test",
          "summary": "Run OpenAPI connector definition generator tests",
          "make_target": "openapi-definition-gen-test",
          "command": [
            "make",
            "openapi-definition-gen-test"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "sourcegen-test",
          "summary": "Run source generator and catalog runtime projection tests",
          "make_target": "sourcegen-test",
          "command": [
            "make",
            "sourcegen-test"
          ]
        }
      ],
      "outputs": [
        "internal/connectorcatalog/catalog/<category>.yaml",
        "sources/<source-id>"
      ],
      "ci_jobs": [
        "catalog",
        "coverage"
      ]
    },
    {
      "id": "proto",
      "title": "Proto Contracts",
      "summary": "Keeps proto definitions, generated Go/Python outputs, and breaking-change checks aligned.",
      "change_reason": "proto definitions or generated SDK/runtime types changed",
      "triggers": [
        "buf.gen.yaml",
        "buf.yaml",
        "proto/**"
      ],
      "generator": {
        "make_target": "proto-generate",
        "command": [
          "make",
          "proto-generate"
        ],
        "summary": "Regenerate Go and Python proto artifacts."
      },
      "checks": [
        {
          "key": "proto-lint",
          "summary": "Lint proto definitions",
          "make_target": "proto-lint",
          "command": [
            "make",
            "proto-lint"
          ]
        },
        {
          "key": "proto-generate-check",
          "summary": "Verify generated proto outputs are up to date",
          "make_target": "proto-generate-check",
          "command": [
            "make",
            "proto-generate-check"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "proto-breaking",
          "summary": "Check proto compatibility against the configured base branch",
          "make_target": "proto-breaking",
          "command": [
            "make",
            "proto-breaking"
          ]
        }
      ],
      "outputs": [
        "gen/cerebro/v1",
        "sdk/python/cerebro/v1"
      ],
      "ci_jobs": [
        "proto"
      ]
    },
    {
      "id": "graph-actions",
      "title": "Graph Action Registry",
      "summary": "Keeps graph action catalog definitions and generated Go registry wiring aligned.",
      "change_reason": "graph action catalog, generated registry, or provider action metadata changed",
      "triggers": [
        "internal/graphactions/action_catalog.yaml",
        "internal/graphactions/registry_gen.go",
        "tools/graphactiongen/**"
      ],
      "generator": {
        "make_target": "graph-action-generate",
        "command": [
          "make",
          "graph-action-generate"
        ],
        "summary": "Regenerate the graph action registry from the reviewed action catalog."
      },
      "checks": [
        {
          "key": "graph-action-check",
          "summary": "Verify generated graph action registry is up to date",
          "make_target": "graph-action-check",
          "command": [
            "make",
            "graph-action-check"
          ],
          "include_in_pr_generated_step": true
        }
      ],
      "outputs": [
        "internal/graphactions/registry_gen.go"
      ],
      "ci_jobs": [
        "graph-actions"
      ]
    },
    {
      "id": "detection-catalog",
      "title": "Detection Catalog",
      "summary": "Keeps generated detection catalog artifacts aligned with policy definitions.",
      "change_reason": "policy definitions or detection catalog generation changed",
      "triggers": [
        "policies/**",
        "internal/findingdsl/**",
        "tools/findingdsl/**",
        "tools/detectioncatalog/**"
      ],
      "generator": {
        "make_target": "detection-catalog-generate",
        "command": [
          "make",
          "detection-catalog-generate"
        ],
        "summary": "Regenerate detection catalog artifacts."
      },
      "checks": [
        {
          "key": "detection-catalog-check",
          "summary": "Verify detection catalog artifacts are up to date",
          "make_target": "detection-catalog-check",
          "command": [
            "make",
            "detection-catalog-check"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "finding-dsl-check",
          "summary": "Validate PolicyFindingRule DSL files",
          "make_target": "finding-dsl-check",
          "command": [
            "make",
            "finding-dsl-check"
          ]
        },
        {
          "key": "catalog-check",
          "summary": "Validate policy catalog metadata",
          "make_target": "catalog-check",
          "command": [
            "make",
            "catalog-check"
          ]
        }
      ],
      "outputs": [
        "docs/domains/policies.md"
      ],
      "ci_jobs": [
        "catalog"
      ]
    },
    {
      "id": "source-runtime",
      "title": "Source Runtime Codegen",
      "summary": "Keeps connector-definition-driven source runtime scaffolds, catalog runtime adapters, and generated-style projectors aligned.",
      "change_reason": "connector definitions, Source Runtime SDK generator, or generic projection templates changed",
      "triggers": [
        "internal/connectordefinitions/**",
        "internal/connectorcatalog/catalog/**",
        "internal/sourcegen/**",
        "internal/sourceprojection/catalogruntime.go",
        "sources/internal/catalogruntime/**"
      ],
      "generator": {
        "make_target": "sourcegen-test",
        "command": [
          "make",
          "sourcegen-test"
        ],
        "summary": "Validate sourcegen-ready connector definitions, catalog runtime execution, and generated projection coverage."
      },
      "checks": [
        {
          "key": "sourcegen-check",
          "summary": "Verify connector definitions remain sourcegen-ready",
          "make_target": "sourcegen-check",
          "command": [
            "make",
            "sourcegen-check"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "sourcegen-test",
          "summary": "Run source generator and catalog runtime projection tests",
          "make_target": "sourcegen-test",
          "command": [
            "make",
            "sourcegen-test"
          ]
        }
      ],
      "outputs": [
        "sources/<source-id>",
        "internal/sourceprojection/<source-id>.go"
      ],
      "ci_jobs": [
        "catalog",
        "coverage"
      ]
    },
    {
      "id": "finding-rule-scaffold",
      "title": "Finding Rule Scaffold",
      "summary": "Generates metadata-complete finding rule, fixture, and test scaffolds that satisfy rule catalog contracts before registration.",
      "change_reason": "finding rule scaffold templates, lifecycle semantics, or rule metadata contracts changed",
      "triggers": [
        "cmd/cerebro/finding_rule.go",
        "cmd/cerebro/finding_rule_test.go",
        "internal/findings/event_rule.go",
        "internal/findings/rule_metadata.go",
        "internal/findings/rule_fixture_test.go"
      ],
      "generator": {
        "make_target": "finding-rule-scaffold-test",
        "command": [
          "make",
          "finding-rule-scaffold-test"
        ],
        "summary": "Validate generated finding rule scaffolds, metadata defaults, control refs, fixtures, and no-match examples."
      },
      "checks": [
        {
          "key": "finding-rule-scaffold-test",
          "summary": "Run finding rule scaffold generator tests",
          "make_target": "finding-rule-scaffold-test",
          "command": [
            "make",
            "finding-rule-scaffold-test"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "finding-rule-test",
          "summary": "Run built-in finding rule fixtures and catalog behavior tests",
          "make_target": "finding-rule-test",
          "command": [
            "make",
            "finding-rule-test"
          ]
        }
      ],
      "outputs": [
        "internal/findings/<rule>_rule.go",
        "internal/findings/<rule>_rule_test.go",
        "internal/findings/testdata/rules/<rule-id>.json"
      ],
      "ci_jobs": [
        "coverage",
        "catalog"
      ]
    },
    {
      "id": "openapi-typescript",
      "title": "OpenAPI TypeScript Contracts",
      "summary": "Generates TypeScript contract types from the public OpenAPI document and verifies checked-in output.",
      "change_reason": "The public OpenAPI schema or TypeScript type generator changed",
      "triggers": [
        "api/openapi.yaml",
        "tools/openapitsgen/**",
        "sdk/typescript/src/generated/openapi-types.ts"
      ],
      "generator": {
        "make_target": "openapi-ts-generate",
        "command": [
          "make",
          "openapi-ts-generate"
        ],
        "summary": "Regenerate TypeScript contract types from api/openapi.yaml."
      },
      "checks": [
        {
          "key": "openapi-ts-check",
          "summary": "Verify generated TypeScript contract types are current",
          "make_target": "openapi-ts-check",
          "command": [
            "make",
            "openapi-ts-check"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "sdk-typescript-check",
          "summary": "Type-check the TypeScript SDK and generated contract consumers",
          "make_target": "sdk-typescript-check",
          "command": [
            "make",
            "sdk-typescript-check"
          ]
        }
      ],
      "outputs": [
        "sdk/typescript/src/generated/openapi-types.ts"
      ],
      "ci_jobs": [
        "codegen",
        "sdk"
      ]
    },
    {
      "id": "finding-dsl-schema",
      "title": "Finding DSL Schema",
      "summary": "Generates the JSON Schema used to validate PolicyFindingRule YAML authoring files.",
      "change_reason": "Finding DSL types, validation, or schema generation changed",
      "triggers": [
        "internal/findingdsl/**",
        "tools/findingdsl/**",
        "schemas/policy-finding-rule.schema.json"
      ],
      "generator": {
        "make_target": "finding-dsl-schema-generate",
        "command": [
          "make",
          "finding-dsl-schema-generate"
        ],
        "summary": "Regenerate the PolicyFindingRule JSON Schema."
      },
      "checks": [
        {
          "key": "finding-dsl-schema-check",
          "summary": "Verify the PolicyFindingRule JSON Schema is current",
          "make_target": "finding-dsl-schema-check",
          "command": [
            "make",
            "finding-dsl-schema-check"
          ],
          "include_in_pr_generated_step": true
        }
      ],
      "outputs": [
        "schemas/policy-finding-rule.schema.json"
      ],
      "ci_jobs": [
        "codegen",
        "catalog"
      ]
    },
    {
      "id": "policy-rule-catalog",
      "title": "Policy Rule Catalog",
      "summary": "Generates domain-scoped Go policy rule catalogs from reviewed finding DSL files and extensions.",
      "change_reason": "Policy DSL definitions, rule extensions, or catalog generation changed",
      "triggers": [
        "policies/**",
        "internal/compliance/policy_rule_extensions.yaml",
        "tools/policyrulegen/**",
        "internal/findings/policy_rule_catalog_*_gen.go"
      ],
      "generator": {
        "make_target": "policy-rule-generate",
        "command": [
          "make",
          "policy-rule-generate"
        ],
        "summary": "Regenerate domain-scoped policy rule catalogs."
      },
      "checks": [
        {
          "key": "policy-rule-check",
          "summary": "Verify generated policy rule catalogs are current",
          "make_target": "policy-rule-check",
          "command": [
            "make",
            "policy-rule-check"
          ],
          "include_in_pr_generated_step": true
        }
      ],
      "outputs": [
        "internal/findings/policy_rule_catalog_*_gen.go"
      ],
      "ci_jobs": [
        "codegen",
        "catalog"
      ]
    },
    {
      "id": "control-index",
      "title": "Compliance Control Index",
      "summary": "Generates the compliance control coverage index from framework and control-family definitions.",
      "change_reason": "Compliance framework, profile, or control coverage definitions changed",
      "triggers": [
        "internal/compliance/**",
        "tools/controlindex/**",
        "docs/reference/compliance-control-coverage.json"
      ],
      "generator": {
        "make_target": "control-index-generate",
        "command": [
          "make",
          "control-index-generate"
        ],
        "summary": "Regenerate the compliance control coverage index."
      },
      "checks": [
        {
          "key": "control-index-check",
          "summary": "Verify the generated compliance control coverage index is current",
          "make_target": "control-index-check",
          "command": [
            "make",
            "control-index-check"
          ],
          "include_in_pr_generated_step": true
        }
      ],
      "outputs": [
        "docs/reference/compliance-control-coverage.json"
      ],
      "ci_jobs": [
        "codegen",
        "catalog"
      ]
    },
    {
      "id": "connector-onboard",
      "title": "Connector Onboarding Pipeline",
      "summary": "Orchestrates OpenAPI definition generation, grammar classification, source generation, and catalog output.",
      "change_reason": "Connector onboarding orchestration or any of its generator stages changed",
      "triggers": [
        "tools/connectoronboard/**",
        "internal/connectordefinitions/openapigen/**",
        "internal/sourcegen/**"
      ],
      "generator": {
        "make_target": "connector-onboard",
        "command": [
          "make",
          "connector-onboard",
          "SPEC=<provider-openapi>",
          "SOURCE_ID=<source-id>"
        ],
        "summary": "Run connector onboarding against an operator-provided provider OpenAPI document."
      },
      "checks": [
        {
          "key": "openapi-definition-gen-test",
          "summary": "Validate OpenAPI definition generation and onboarding orchestration",
          "make_target": "openapi-definition-gen-test",
          "command": [
            "make",
            "openapi-definition-gen-test"
          ],
          "include_in_pr_generated_step": true
        },
        {
          "key": "sourcegen-test",
          "summary": "Validate generated source runtime output",
          "make_target": "sourcegen-test",
          "command": [
            "make",
            "sourcegen-test"
          ]
        }
      ],
      "outputs": [
        "internal/connectorcatalog/catalog/<category>/<source-id>.yaml",
        "sources/<source-id>"
      ],
      "ci_jobs": [
        "codegen",
        "catalog"
      ]
    }
  ]
}
