{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro.source-operation-authority-ledger.schema.json",
  "title": "Cerebro source operation authority ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "inventory", "runtime_implementation", "defaults", "overrides"],
  "properties": {
    "schema_version": { "const": "cerebro.source-operation-authority/v2" },
    "revision": { "type": "integer", "minimum": 1 },
    "inventory": { "$ref": "#/$defs/inventory" },
    "runtime_implementation": { "$ref": "#/$defs/runtimeImplementation" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pull", "push"],
      "properties": {
        "pull": { "$ref": "#/$defs/defaultAuthority" },
        "push": { "$ref": "#/$defs/defaultAuthority" }
      }
    },
    "overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/override" }
    }
  },
  "$defs": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_sha256", "family_count", "pull_family_count", "push_family_count"],
      "properties": {
        "digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "family_count": { "type": "integer", "minimum": 1 },
        "pull_family_count": { "type": "integer", "minimum": 1 },
        "push_family_count": { "type": "integer", "minimum": 1 }
      }
    },
    "runtimeImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "bindings"],
      "properties": {
        "canonicalization": { "const": "go_ast_declaration_sha256/v1" },
        "bindings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/goDeclarationBinding" }
        }
      }
    },
    "goDeclarationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "symbol", "digest_sha256"],
      "properties": {
        "role": { "enum": ["durable_pull_dispatch", "preview_rust_selector", "rust_authoritative_selector", "tailscale_authoritative_selector"] },
        "path": { "type": "string", "pattern": "^internal/.+\\.go$" },
        "symbol": { "type": "string", "minLength": 1 },
        "digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "discover", "read_page", "push_admit", "append", "project", "checkpoint_commit", "product_read"],
      "properties": {
        "check": { "$ref": "#/$defs/owner" },
        "discover": { "$ref": "#/$defs/owner" },
        "read_page": { "$ref": "#/$defs/owner" },
        "push_admit": { "$ref": "#/$defs/owner" },
        "append": { "$ref": "#/$defs/owner" },
        "project": { "$ref": "#/$defs/owner" },
        "checkpoint_commit": { "$ref": "#/$defs/owner" },
        "product_read": { "$ref": "#/$defs/owner" }
      }
    },
    "authority": {
      "type": "object",
      "required": ["state", "credential_owner", "network_owner", "operations"],
      "properties": {
        "state": { "enum": ["authoritative", "blocked", "compatibility", "shadow", "shadow_disabled"] },
        "credential_owner": { "$ref": "#/$defs/owner" },
        "network_owner": { "$ref": "#/$defs/owner" },
        "operations": { "$ref": "#/$defs/operations" },
        "candidate_kernel": { "$ref": "#/$defs/candidateKernel" }
      }
    },
    "defaultAuthority": {
      "allOf": [{ "$ref": "#/$defs/authority" }],
      "unevaluatedProperties": false
    },
    "override": {
      "allOf": [
        { "$ref": "#/$defs/authority" },
        {
          "type": "object",
          "required": ["mode", "source_id", "family_id"],
          "properties": {
            "mode": { "enum": ["pull", "push"] },
            "source_id": { "type": "string", "minLength": 1 },
            "family_id": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "candidateKernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "credential_free", "network_allowed", "plan_id", "provider_kernel", "event_kind", "schema_ref", "implementation_evidence"],
      "properties": {
        "runtime": { "const": "credential_free_rust_worker" },
        "credential_free": { "const": true },
        "network_allowed": { "const": false },
        "plan_id": { "type": "string", "minLength": 1 },
        "provider_kernel": { "type": "string", "minLength": 1 },
        "event_kind": { "type": "string", "minLength": 1 },
        "schema_ref": { "type": "string", "minLength": 1 },
        "implementation_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "required_markers"],
            "properties": {
              "path": { "type": "string", "pattern": "^crates/.+\\.rs$" },
              "required_markers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "owner": {
      "enum": [
        "authenticated_push_admission",
        "authenticated_push_transport",
        "go_source_push_admission",
        "go_source_runtime",
        "go_source_runtime_store",
        "go_trusted_runtime_host",
        "not_applicable",
        "organizational_projection"
      ]
    }
  }
}
