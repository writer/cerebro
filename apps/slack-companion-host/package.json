{
  "name": "@writer/cerebro-slack-companion-host",
  "version": "0.1.0",
  "private": true,
  "description": "Slack runtime and host adapters for Cerebro",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writer/cerebro.git",
    "directory": "apps/slack-companion-host"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @writer/cerebro-slack-companion",
    "pretypecheck": "npm run build --workspace @writer/cerebro-slack-companion",
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "check:compat": "tsc -p tsconfig.public-compat.json --noEmit && tsc -p tsconfig.evidence-recheck.json && node --test compat/public-evidence-recheck-compatibility.test.mjs",
    "start": "node dist/src/main.js",
    "start:off-slack": "node dist/src/off-slack-main.js",
    "start:off-slack-v2": "node dist/src/off-slack-v2-main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "cerebro": {
    "runtimeDependencyOwners": {
      "@slack/bolt": "security-platform"
    }
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1116.0",
    "@aws-sdk/lib-dynamodb": "3.1116.0",
    "@slack/bolt": "5.0.0",
    "@writer/cerebro-sdk": "0.1.0",
    "@writer/cerebro-slack-companion": "0.1.0"
  },
  "devDependencies": {
    "@slack/types": "3.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
