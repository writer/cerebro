{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\" capture codex",
            "timeout": 120,
            "statusMessage": "Starting execution receipt capture"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\" capture codex",
            "timeout": 30,
            "statusMessage": "Recording execution receipt"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\" capture codex",
            "timeout": 30,
            "statusMessage": "Recording approval request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\" capture codex",
            "timeout": 30,
            "statusMessage": "Completing execution receipt"
          }
        ]
      }
    ]
  }
}
