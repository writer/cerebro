{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cerebro:schema:product-release-published:v1",
  "title": "Cerebro product release published event",
  "description": "A topology-neutral notification that identifies one signed Cerebro product release manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "release_commit",
    "release_url",
    "manifest_url",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "cerebro.product-release-published/v1"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifest_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/cerebro-product-release\\.json$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
