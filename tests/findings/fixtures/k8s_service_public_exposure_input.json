{
  "resource": {
    "external_id": "payments-service",
    "resource_type": "k8s.service",
    "provider": "kubernetes",
    "name": "payments-service",
    "metadata": {
      "cluster": "prod-east"
    }
  },
  "config": {
    "namespace": "payments",
    "type": "LoadBalancer",
    "annotations": {
      "service.beta.kubernetes.io/aws-load-balancer-internal": "false",
      "external-dns.alpha.kubernetes.io/hostname": "payments.example.com"
    },
    "loadBalancer": [
      {
        "ip": "34.117.200.10"
      },
      {
        "hostname": "payments-prod-123456.us-east-1.elb.amazonaws.com"
      }
    ],
    "externalIPs": [
      "44.240.0.10"
    ],
    "ports": [
      {
        "port": 443,
        "targetPort": 8443,
        "protocol": "TCP"
      }
    ]
  }
}
