{
  "resource": {
    "external_id": "projects/sample-project/buckets/public-secrets",
    "resource_type": "gcp.storage.bucket",
    "provider": "gcp",
    "name": "public-secrets",
    "metadata": {
      "project": "sample-project"
    }
  },
  "config": {
    "is_public": true,
    "location": "US",
    "public_access_prevention": "inherited",
    "uniform_bucket_level_access": {
      "enabled": false
    },
    "objectsSample": [
      {
        "key": "backups/credentials.zip",
        "size": 53248
      },
      {
        "key": "terraform/secrets.tfvars",
        "size": 4096
      },
      {
        "key": "docs/readme.md",
        "size": 2048
      }
    ]
  }
}
