{
  "name": "@cerebro/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the Cerebro platform APIs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "generate:types": "node ./scripts/generate-types.mjs",
    "validate:package": "node ./scripts/validate-package.mjs",
    "changeset": "changeset",
    "prepack": "npm run build"
  },
  "keywords": [
    "cerebro",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.10.6",
    "openapi-typescript": "^7.4.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vitest": "^1.1.3"
  }
}
