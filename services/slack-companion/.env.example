SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_SOCKET_MODE=true
SLACK_APP_TOKEN=xapp-...
SLACK_DEFAULT_CHANNEL_ID=
SLACK_ALLOWED_TEAM_IDS=
SLACK_TRIAGE_CHANNEL_IDS=C0B2VJDFJ5N
# Channels where Cerebro can ask a named person to confirm risk activity. Defaults to triage channels.
SLACK_RISK_ATTESTATION_CHANNEL_IDS=C0B2VJDFJ5N
SLACK_RISK_ATTESTATION_TIMEOUT_MS=10000
# Optional per-channel posture: strict, quiet, watch, or eager.
SLACK_TRIAGE_CHANNEL_POLICIES=C0B2VJDFJ5N:watch
SLACK_TRIAGE_AUTO_REPLY=true
SLACK_LIFECYCLE_NOTICES_ENABLED=true
SLACK_LIFECYCLE_CHANNEL_IDS=C0B2VJDFJ5N
SLACK_RESEARCH_MAX_CHANNELS=30
SLACK_RESEARCH_HISTORY_LIMIT=500
SLACK_AUDIT_LOGS_TOKEN=

CEREBRO_BASE_URL=https://cerebro.adm.dev.qordobadev.com
CEREBRO_TENANT_ID=writer
CEREBRO_WEB_BASE_URL=https://cerebro-web.adm.dev.qordobadev.com
CEREBRO_DEFAULT_RUNTIME_IDS=writer-github-audit,writer-okta-user,writer-security-tooling-map-tools,writer-evidence-cas-cases
CEREBRO_COMPANION_RUNTIME_ID=writer-slack-companion
CEREBRO_ASSISTANT_HELP_MENTION=

# Prefer separate tenant-scoped credentials with route-specific scopes.
CEREBRO_READ_API_KEY=
CEREBRO_FINDINGS_API_KEY=
CEREBRO_SOURCE_API_KEY=
CEREBRO_RUNTIME_RESPONSE_API_KEY=
CEREBRO_GRAPH_ACTION_API_KEY=

# Optional read-only EvidenceCAS integration for manifest refs surfaced by Cerebro evidence.
EVIDENCE_CAS_BASE_URL=
EVIDENCE_CAS_READ_TOKEN=
EVIDENCE_CAS_READ_TOKEN_INFISICAL_SECRET_NAME=EVIDENCE_CAS_READ_TOKEN
EVIDENCE_CAS_DEFAULT_BUCKET=cases
EVIDENCE_CAS_TIMEOUT_MS=15000

# Optional read-only Infisical metadata and fingerprint tools.
INFISICAL_ENABLED=true
INFISICAL_BASE_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_PROJECT_SLUG=wi-cerebro-slack-companion
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/
INFISICAL_IDENTITY_ID=
INFISICAL_AWS_REGION=us-east-1
INFISICAL_STS_ENDPOINT=https://sts.us-east-1.amazonaws.com/
INFISICAL_TIMEOUT_MS=15000
INFISICAL_CACHE_TTL_MS=600000
INFISICAL_ALLOW_SECRET_VALUES=false

# Optional read-only Panther MCP integration.
# The Panther MCP server should own PANTHER_INSTANCE_URL and PANTHER_API_TOKEN.
PANTHER_MCP_ENABLED=false
PANTHER_MCP_URL=http://panther-mcp:8000/mcp
PANTHER_MCP_AUTH_TOKEN=
PANTHER_MCP_ALLOWED_TOOLS=list_alerts,get_alert,get_alert_events,query_data_lake,get_table_schema,list_databases,list_database_tables,list_detections,get_detection,get_permissions
PANTHER_MCP_ALLOW_MUTATING_TOOLS=false
PANTHER_MCP_TIMEOUT_MS=15000

# Slack users who can perform write workflows from Slack.
SLACK_FINDING_WRITE_USER_IDS=U123,U456
SLACK_SOURCE_WRITE_USER_IDS=U123
SLACK_RESPONSE_WRITE_USER_IDS=U123
SLACK_GRAPH_ACTION_USER_IDS=U123
SLACK_OPERATOR_USER_IDS=U123

# Optional user mapping for Cerebro audit claims.
CEREBRO_SLACK_USER_MAP_JSON={"U123":{"actor_id":"alice@writer.com","display_name":"Alice"}}

# Proactive alert triage.
CEREBRO_TRIAGE_ENABLED=true
CEREBRO_TRIAGE_THREAD_STATE_TABLE_NAME=
CEREBRO_TRIAGE_MIN_CONFIDENCE=0
CEREBRO_TRIAGE_MAX_RESEARCH_STEPS=12
CEREBRO_TRIAGE_TIMEOUT_MS=300000
CEREBRO_TRIAGE_MAX_CONCURRENT=2
CEREBRO_ASSISTANT_RUNTIME=pi

# Durable security memory for normal patterns, prior investigations, and answer summaries.
SECURITY_LEARNING_ENABLED=true
SECURITY_LEARNING_TABLE_NAME=
SECURITY_LEARNING_MAX_SEARCH_RESULTS=6
CEREBRO_SLACK_CHANNEL_LEARNING_ENABLED=true
CEREBRO_SLACK_CHANNEL_LEARNING_EXCLUDED_CHANNEL_IDS=
CEREBRO_SLACK_CHANNEL_LEARNING_BATCH_SIZE=12
CEREBRO_SLACK_CHANNEL_LEARNING_FLUSH_INTERVAL_MS=600000
CEREBRO_DAILY_NOTES_ENABLED=true
CEREBRO_DAILY_NOTES_TIME_ZONE=America/Los_Angeles
CEREBRO_DAILY_NOTES_CONSOLIDATION_HOUR=2
CEREBRO_DAILY_NOTES_CONSOLIDATION_MINUTE=30
CEREBRO_DAILY_NOTES_NIGHT_START_HOUR=0
CEREBRO_DAILY_NOTES_NIGHT_END_HOUR=6
CEREBRO_DAILY_NOTES_CHECK_INTERVAL_MS=900000
CEREBRO_DAILY_NOTES_RETENTION_DAYS=30

# File-backed working memory loaded into each Cerebro prompt.
# Use compact non-secret notes only; never store raw logs, transcripts, or hidden reasoning.
SECURITY_WORKING_MEMORY_ENABLED=true
SECURITY_WORKING_MEMORY_DIR=
SECURITY_WORKING_MEMORY_CHAR_LIMIT=2200
SECURITY_TEAM_MEMORY_CHAR_LIMIT=1375
SECURITY_LEARNING_DOCS_ENABLED=true
SECURITY_LEARNING_DOCS_DIR=
SECURITY_LEARNING_DOCS_CHAR_LIMIT=12000

# Runtime code workspace. Host shell execution stays off until an OS sandbox is configured.
CEREBRO_CODE_WRITE_ENABLED=true
CEREBRO_CODE_WORKSPACE_DIR=/memory/code
CEREBRO_CODE_DEFAULT_REPO=writer/cerebro
CEREBRO_CODE_REPO_PATH_PREFIX=services/slack-companion
CEREBRO_CODE_WRITE_ALLOWED_ORGS=Writer,WriterColab,WriterInternal
CEREBRO_CODE_BRANCH_PREFIX=cerebro/runtime
CEREBRO_CODE_MAX_FILE_BYTES=120000
CEREBRO_CODE_MAX_FILES=12
CEREBRO_CODE_SHELL_ENABLED=false
CEREBRO_CODE_SHELL_TIMEOUT_MS=15000
CEREBRO_CODE_SHELL_MAX_OUTPUT_BYTES=24000
CEREBRO_CODE_SHELL_MAX_COMMAND_BYTES=4000
CEREBRO_CODE_GITHUB_TOKEN=
CEREBRO_CODE_GITHUB_APP_ID=
CEREBRO_CODE_GITHUB_INSTALLATION_ID=
CEREBRO_CODE_GITHUB_PRIVATE_KEY_BASE64=

# Sandboxed tool composition for multi-source and repeated assistant checks.
# Nested calls keep the same Slack identity, approval, target, and evidence policies as direct tool calls.
CEREBRO_CODE_MODE_ENABLED=true
CEREBRO_CODE_MODE_MAX_TOOL_CALLS=8
CEREBRO_CODE_MODE_MAX_SIDE_EFFECT_CALLS=1
CEREBRO_CODE_MODE_TIMEOUT_MS=30000
CEREBRO_CODE_MODE_MEMORY_LIMIT_BYTES=67108864
CEREBRO_CODE_MODE_MAX_SCRIPT_BYTES=24576
CEREBRO_CODE_MODE_MAX_OUTPUT_BYTES=65536

# Jira and Linear ticket defaults. Draft tools do not write; create tools require explicit ticket requests and auth.
JIRA_BASE_URL=
JIRA_AUTH_EMAIL=
JIRA_API_TOKEN=
JIRA_API_TOKEN_INFISICAL_SECRET_NAME=JIRA_API_TOKEN
JIRA_DEFAULT_PROJECT_KEY=
JIRA_DEFAULT_ISSUE_TYPE=Task
LINEAR_API_KEY=
LINEAR_API_KEY_INFISICAL_SECRET_NAME=LINEAR_API_KEY
LINEAR_DEFAULT_TEAM_ID=
TICKETING_MAX_DESCRIPTION_CHARS=6000
TICKETING_TIMEOUT_MS=15000

# Read-only compliance source context from github.com/writer/cerebro.
CEREBRO_COMPLIANCE_CONTEXT_ENABLED=true
CEREBRO_COMPLIANCE_CONTEXT_REPO=writer/cerebro
CEREBRO_COMPLIANCE_CONTEXT_REF=main
CEREBRO_COMPLIANCE_CONTEXT_LOCAL_DIR=
CEREBRO_COMPLIANCE_CONTEXT_CACHE_TTL_MS=3600000
CEREBRO_COMPLIANCE_CONTEXT_FETCH_TIMEOUT_MS=10000
CEREBRO_COMPLIANCE_CONTEXT_MAX_FILE_BYTES=250000
CEREBRO_COMPLIANCE_CONTEXT_MAX_TOTAL_BYTES=600000

# Reviewed recursive improvement. Production values are injected by Pulumi.
CEREBRO_SELF_REPAIR_ENABLED=true
CEREBRO_SELF_REPAIR_CREATE_PR=true
CEREBRO_SELF_REPAIR_THRESHOLD=2
CEREBRO_SELF_REPAIR_LOOKBACK_HOURS=24
CEREBRO_SELF_REPAIR_COOLDOWN_HOURS=168
CEREBRO_IMPROVEMENT_ENABLED=false
CEREBRO_IMPROVEMENT_TABLE_NAME=
CEREBRO_IMPROVEMENT_ARTIFACT_BUCKET=
CEREBRO_IMPROVEMENT_QUEUE_URL=
CEREBRO_IMPROVEMENT_PROMOTION_KEY_ID=
CEREBRO_IMPROVEMENT_SIGNAL_THRESHOLD=2
CEREBRO_IMPROVEMENT_POLL_INTERVAL_MS=5000
CEREBRO_IMPROVEMENT_STALE_RUN_HOURS=72

# Scheduled Cerebro checks. Uses CEREBRO_SCHEDULES_TABLE_NAME when set,
# otherwise SECURITY_LEARNING_TABLE_NAME, then process memory for local runs.
CEREBRO_SCHEDULES_ENABLED=true
CEREBRO_SCHEDULES_TABLE_NAME=
CEREBRO_SCHEDULES_POLL_INTERVAL_MS=60000
CEREBRO_SCHEDULES_MAX_CONCURRENT=1
CEREBRO_SCHEDULES_DEFAULT_CHANNEL_ID=
CEREBRO_SCHEDULES_DEFAULT_TIME_ZONE=America/Los_Angeles

# HA coordination for multiple Socket Mode workers.
CEREBRO_COMPANION_VERSION=local
CEREBRO_TELEMETRY_ENABLED=true
CEREBRO_METRICS_ENABLED=true
CEREBRO_TELEMETRY_SERVICE_NAME=cerebro-slack-companion
CEREBRO_DEPLOYMENT_ENVIRONMENT=development
OTEL_RESOURCE_ATTRIBUTES=service.namespace=cerebro
CEREBRO_HA_EVENT_DEDUPE_ENABLED=true
CEREBRO_HA_EVENT_DEDUPE_TTL_SECONDS=86400
CEREBRO_LIFECYCLE_NOTICE_TTL_SECONDS=3600
CEREBRO_DEPLOYMENT_FENCE_ENABLED=true
CEREBRO_DEPLOYMENT_FENCE_CACHE_MS=5000
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=

PI_ENABLED=true
PI_PROVIDER=amazon-bedrock
PI_MODEL=us.anthropic.claude-opus-4-8
PI_THINKING_LEVEL=medium
PI_EXECUTION_MODEL=
PI_EXECUTION_THINKING_LEVEL=
