{
  "name": "@writer/cerebro-slack-host",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Slack host service for Cerebro operators.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "architecture:check": "node scripts/architecture-check.mjs",
    "check": "npm run typecheck && npm run architecture:check && npm test",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "eval:autonomy": "node --import tsx scripts/autonomy-synthetic-eval-report.ts",
    "eval:compliance": "node --import tsx scripts/compliance-synthetic-eval-report.ts",
    "eval:assistant": "node --import tsx scripts/assistant-replay-eval-report.ts",
    "eval:contract": "node --import tsx scripts/assistant-hard-corpus-hillclimb.ts",
    "eval:contract:dev": "node --import tsx scripts/assistant-hard-corpus-hillclimb.ts --development-only",
    "eval:hillclimb": "node --import tsx scripts/assistant-frontier-hillclimb.ts",
    "eval:hillclimb:dev": "node --import tsx scripts/assistant-frontier-hillclimb.ts --generated-train 4 --generated-validation 4 --train-cases 8 --validation-cases 8 --held-out-cases 8 --mutations 2 --children 1",
    "eval:ensemble": "node --import tsx scripts/assistant-frontier-hillclimb.ts --generated-train 4 --generated-validation 4 --train-cases 8 --validation-cases 8 --held-out-cases 8 --mutations 2 --children 1",
    "eval:offline": "node --import tsx scripts/assistant-offline-harness.ts",
    "eval:offline:held-out": "node --import tsx scripts/assistant-offline-harness.ts --held-out",
    "eval:specialists": "node --import tsx scripts/specialist-routing-eval-report.ts",
    "eval:traffic": "node --import tsx scripts/assistant-traffic-replay-report.ts",
    "backfill:slack": "node dist/src/learning/slack-channel-backfill-main.js",
    "compound:library": "node dist/src/learning/company-library-compound-main.js",
    "review:local": "node scripts/local-review-check.mjs",
    "sync:cerebro-sdk": "node scripts/sync-cerebro-sdk.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1075.0",
    "@aws-sdk/client-ecs": "3.1075.0",
    "@aws-sdk/client-kms": "3.1075.0",
    "@aws-sdk/client-s3": "3.1075.0",
    "@aws-sdk/client-sqs": "3.1075.0",
    "@aws-sdk/credential-provider-node": "3.972.58",
    "@aws-sdk/lib-dynamodb": "3.1075.0",
    "@earendil-works/pi-agent-core": "0.80.2",
    "@earendil-works/pi-ai": "0.80.2",
    "@flue/runtime": "1.0.0-beta.7",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/bolt": "4.7.3",
    "@smithy/hash-node": "4.4.2",
    "@smithy/protocol-http": "5.5.2",
    "@smithy/signature-v4": "5.5.2",
    "@writer/cerebro-sdk": "file:vendor/cerebro-sdk",
    "dotenv": "17.4.2",
    "quickjs-emscripten": "0.32.0",
    "valibot": "1.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
